{
  "name": "fluxo-music",
  "version": "3.9.32",
  "description": "Fluxo Music - Player",
  "main": "main.js",
  "author": "Adrian",
  "license": "ISC",
  "homepage": "https://github.com/Harleyzinn/fluxo",
  "discordClientId": "1487787955186565250",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:services": "node tools/check-services.cjs",
    "test:smoke": "node tools/smoke-electron.cjs",
    "prepare:media": "node tools/prepare-extractor.cjs",
    "prebuild": "npm test && npm run prepare:media",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.1.1",
    "express": "^4.19.2",
    "hls.js": "^1.6.16",
    "yt-dlp-exec": "^1.0.2",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "extract-zip": "2.0.1",
    "playwright": "1.63.0"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.devpotato.fluxomusic",
    "productName": "Fluxo Music",
    "artifactName": "Fluxo-Music-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "script.js",
      "index.html",
      "style.css",
      "icon.ico",
      "README.md",
      "node_modules/**/*",
      "!node_modules/yt-dlp-exec/bin{,/**}",
      "!node_modules/.cache{,/**}"
    ],
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/yt-dlp-exec/bin/yt-dlp.exe",
        "to": "yt-dlp-bin/yt-dlp.exe"
      },
      {
        "from": "vendor/deno/deno.exe",
        "to": "yt-dlp-bin/deno.exe"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Harleyzinn/fluxo/releases/latest/download/"
    }
  }
}
